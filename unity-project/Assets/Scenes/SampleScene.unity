  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClaudeLab.ClaudeLabPanel
  agent: {fileID: 884547658}
  presets:
  - label: Ball vs. block
    prompt: Drop a ball from 2 meters and a block from 1 meter.
  - label: Heavy vs. light
    prompt: Drop a 1 kg ball and a 5 kg ball from 2 meters.
  - label: Pendulum
    prompt: Set up a pendulum I can watch swing.
  - label: Ramp
    prompt: Set up a 30 degree ramp.
  - label: How fast did it hit?
    prompt: Measure the objects. How long did each one take to fall, and how fast
      was it going when it hit?
  - label: Heavier + higher
    prompt: Make the ball twice as heavy and drop it from higher.
  - label: Energy graph
    prompt: Drop a ball from 3 meters and graph its energy as it falls.
  - label: Explain the graph
    prompt: Read the measurement and explain what the graph shows.
  - label: Moon gravity
    prompt: Switch to Moon gravity and drop a ball from 2 meters.
  - label: Back to Earth
    prompt: Set gravity back to Earth's.
  - label: Clear the lab
    prompt: Clear the lab.
  replyText: {fileID: 876515594}
  statusText: {fileID: 649577522}
  buttonContainer: {fileID: 619423569}
  newConversationButton: {fileID: 617843841}
